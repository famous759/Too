-- ===== CONFIG =====
local Settings = {
    Noclip = true,
    Fly = false,
    AutoCollect = true,
    AutoFarm = true,
    CollectRadius = 50,
    FlySpeed = 50,
    Visible = true
}

-- ===== FLY VARIABLES =====
local flying = false
local flySpeed = 50
local bodyVelocity = nil
local bodyGyro = nil

-- ===== CREATE UI (Rayfield Style - Touch Optimized) =====
local function CreateUI()
